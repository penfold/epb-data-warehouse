{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "RdSAP-Schema-NI-17.4",
  "title": "RdSAP-Schema-21.0.1 GET Certificate API Response",
  "description": "JSON schema for the data returned by the GET /api/certificate endpoint for certificates lodged under RdSAP-Schema-21.0.1. Reflects the output of the export configuration (Rdsap21Base) and the fn_export_json_document PostgreSQL transform. Fields of type Measurement, Money or Sentence may appear as a scalar value or as an object with a qualifier key (quantity/currency/language) plus a value key, depending on whether the originating XML included the attribute.",
  "type": "object",
  "$defs": {
    "measurement_value": {
      "description": "A decimal measurement. Stored as a plain number when the source XML element carried no 'quantity' attribute; stored as an object when the attribute was present.",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "type": "string",
              "description": "Unit of measurement, e.g. 'metres', 'square metres', 'kWh/m2'"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "money_value": {
      "description": "A monetary amount. Stored as a plain number when the source XML element carried no 'currency' attribute; stored as an object when the attribute was present.",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "description": "ISO 4217 currency code, typically 'GBP'"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "sentence_value": {
      "description": "A text value. Stored as a plain string when no 'language' attribute was present in the XML; stored as an object when the attribute was present.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "description": "Language code, e.g. '1' for English"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "flag_value": {
      "description": "An XML Flag type: 'Y' or 'N'.",
      "type": "string",
      "enum": [
        "Y",
        "N"
      ]
    },
    "boolean_string": {
      "description": "An xs:boolean value serialised as a string: 'true' or 'false'.",
      "type": "string",
      "enum": [
        "true",
        "false"
      ]
    },
    "property_summary_item": {
      "type": "object",
      "description": "Summary rating for a single property feature (wall, roof, heating system, etc.).",
      "properties": {
        "description": {
          "$ref": "#/$defs/sentence_value"
        },
        "energy_efficiency_rating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "environmental_efficiency_rating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "required": [
        "description",
        "energy_efficiency_rating",
        "environmental_efficiency_rating"
      ]
    },
    "improvement_details": {
      "description": "Either a coded improvement number or free-text improvement texts.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "improvement_number": {
              "type": "integer"
            }
          },
          "required": [
            "improvement_number"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "improvement_texts": {
              "type": "object",
              "properties": {
                "improvement_summary": {
                  "type": "string"
                },
                "improvement_description": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "improvement_texts"
          ],
          "additionalProperties": false
        }
      ]
    },
    "suggested_improvement": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer"
        },
        "improvement_category": {
          "type": "integer"
        },
        "improvement_type": {
          "type": "string"
        },
        "typical_saving": {
          "$ref": "#/$defs/money_value"
        },
        "energy_performance_rating": {
          "type": "integer"
        },
        "environmental_impact_rating": {
          "type": "integer"
        },
        "improvement_details": {
          "$ref": "#/$defs/improvement_details"
        },
        "indicative_cost": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "sequence",
        "improvement_category",
        "improvement_type",
        "typical_saving",
        "energy_performance_rating",
        "environmental_impact_rating",
        "improvement_details"
      ]
    },
    "sap_floor_dimension": {
      "type": "object",
      "properties": {
        "floor": {
          "type": "integer",
          "description": "Storey floor code (0=ground, 1=first, etc.)"
        },
        "floor_construction": {
          "type": "integer"
        },
        "floor_insulation": {
          "type": "integer"
        },
        "heat_loss_perimeter": {
          "$ref": "#/$defs/measurement_value"
        },
        "total_floor_area": {
          "$ref": "#/$defs/measurement_value"
        },
        "room_height": {
          "$ref": "#/$defs/measurement_value"
        },
        "party_wall_length": {
          "$ref": "#/$defs/measurement_value"
        }
      },
      "required": [
        "floor",
        "heat_loss_perimeter",
        "total_floor_area",
        "room_height",
        "party_wall_length"
      ]
    },
    "sap_room_in_roof": {
      "type": "object",
      "properties": {
        "floor_area": {
          "$ref": "#/$defs/measurement_value"
        },
        "construction_age_band": {
          "type": "string"
        },
        "insulation": {
          "type": "string"
        },
        "roof_room_connected": {
          "$ref": "#/$defs/flag_value"
        }
      },
      "required": [
        "floor_area",
        "construction_age_band"
      ]
    },
    "sap_alternative_wall": {
      "type": "object",
      "properties": {
        "wall_construction": {
          "type": "integer"
        },
        "wall_insulation_type": {
          "type": "integer"
        },
        "wall_area": {
          "$ref": "#/$defs/measurement_value"
        },
        "wall_thickness_measured": {
          "$ref": "#/$defs/flag_value"
        },
        "wall_thickness": {
          "type": "integer"
        },
        "wall_u_value": {
          "type": "number"
        },
        "wall_insulation_thickness": {
          "type": "string"
        },
        "wall_insulation_thickness_measured": {
          "type": "number"
        },
        "wall_insulation_thermal_conductivity": {
          "type": "integer"
        },
        "wall_dry_lined": {
          "$ref": "#/$defs/flag_value"
        },
        "sheltered_wall": {
          "$ref": "#/$defs/flag_value"
        }
      },
      "required": [
        "wall_construction",
        "wall_insulation_type",
        "wall_thickness_measured",
        "wall_dry_lined"
      ]
    },
    "sap_building_part": {
      "type": "object",
      "properties": {
        "building_part_number": {
          "type": "integer"
        },
        "identifier": {
          "type": "string"
        },
        "construction_age_band": {
          "type": "string"
        },
        "sap_floor_dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sap_floor_dimension"
          },
          "minItems": 1
        },
        "floor_u_value": {
          "type": "number"
        },
        "floor_insulation_thickness": {
          "type": "string"
        },
        "floor_heat_loss": {
          "type": "integer"
        },
        "roof_construction": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "roof_insulation_location": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "roof_u_value": {
          "type": "number"
        },
        "roof_insulation_thickness": {
          "type": "string"
        },
        "rafter_insulation_thickness": {
          "type": "string"
        },
        "flat_roof_insulation_thickness": {
          "type": "string"
        },
        "sloping_ceiling_insulation_thickness": {
          "type": "string"
        },
        "wall_construction": {
          "type": "integer"
        },
        "wall_insulation_type": {
          "type": "integer"
        },
        "wall_thickness_measured": {
          "$ref": "#/$defs/flag_value"
        },
        "wall_thickness": {
          "type": "integer"
        },
        "wall_dry_lined": {
          "$ref": "#/$defs/flag_value"
        },
        "wall_u_value": {
          "type": "number"
        },
        "wall_insulation_thickness": {
          "type": "string"
        },
        "wall_insulation_thickness_measured": {
          "type": "number"
        },
        "wall_insulation_thermal_conductivity": {
          "type": "integer"
        },
        "party_wall_construction": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "sap_room_in_roof": {
          "$ref": "#/$defs/sap_room_in_roof"
        },
        "sap_alternative_wall_1": {
          "$ref": "#/$defs/sap_alternative_wall"
        },
        "sap_alternative_wall_2": {
          "$ref": "#/$defs/sap_alternative_wall"
        }
      },
      "required": [
        "building_part_number",
        "construction_age_band",
        "sap_floor_dimensions",
        "floor_heat_loss",
        "roof_construction",
        "roof_insulation_location",
        "wall_construction",
        "wall_insulation_type",
        "wall_thickness_measured",
        "wall_dry_lined",
        "party_wall_construction"
      ]
    },
    "storage_heater": {
      "type": "object",
      "properties": {
        "storage_heater_index_number": {
          "type": "integer"
        },
        "storage_heater_count": {
          "type": "integer"
        },
        "high_heat_retention": {
          "$ref": "#/$defs/boolean_string"
        }
      }
    },
    "main_heating_item": {
      "type": "object",
      "properties": {
        "main_heating_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "main_heating_category": {
          "type": "integer"
        },
        "main_fuel_type": {
          "type": "integer"
        },
        "main_heating_control": {
          "type": "integer"
        },
        "main_heating_index_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "main_heating_data_source": {
          "type": "integer"
        },
        "sap_main_heating_code": {
          "type": "integer"
        },
        "boiler_ignition_type": {
          "type": "integer"
        },
        "boiler_flue_type": {
          "type": "integer"
        },
        "fan_flue_present": {
          "$ref": "#/$defs/flag_value"
        },
        "heat_emitter_type": {
          "type": "integer"
        },
        "main_heating_fraction": {
          "type": "number"
        },
        "has_fghrs": {
          "$ref": "#/$defs/flag_value"
        },
        "fghrs_index_number": {
          "type": "integer"
        },
        "emitter_temperature": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "mcs_installed_heat_pump": {
          "$ref": "#/$defs/boolean_string"
        },
        "central_heating_pump_age": {
          "type": "integer"
        },
        "compensating_controller_index_number": {
          "type": "integer"
        },
        "ttzc_index_number": {
          "type": "integer"
        },
        "community_heat_network_index_number": {
          "type": "integer"
        },
        "community_heat_sub_network_name": {
          "type": "string"
        },
        "community_heat_distribution_type": {
          "type": "integer"
        },
        "community_heat_chp_electricity_generation": {
          "type": "integer"
        },
        "storage_heaters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/storage_heater"
          }
        }
      },
      "required": [
        "main_heating_number",
        "main_heating_category",
        "main_fuel_type",
        "main_heating_control",
        "main_heating_data_source",
        "heat_emitter_type",
        "main_heating_fraction",
        "has_fghrs"
      ]
    },
    "photovoltaic_supply": {
      "description": "Either 'none or no details' summary or a list of one to three PV arrays.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "none_or_no_details": {
              "type": "object",
              "properties": {
                "percent_roof_area": {
                  "type": "number"
                },
                "pv_connection": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              },
              "required": [
                "percent_roof_area"
              ]
            }
          },
          "required": [
            "none_or_no_details"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pv_arrays": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "peak_power": {
                    "$ref": "#/$defs/measurement_value"
                  },
                  "orientation": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "pitch": {
                    "type": "integer"
                  },
                  "overshading": {
                    "type": "integer"
                  }
                },
                "required": [
                  "peak_power",
                  "orientation",
                  "pitch",
                  "overshading"
                ]
              },
              "minItems": 1,
              "maxItems": 3
            }
          },
          "required": [
            "pv_arrays"
          ]
        }
      ]
    },
    "pv_battery": {
      "type": "object",
      "properties": {
        "battery_capacity": {
          "type": "number"
        }
      }
    },
    "sap_window_item": {
      "type": "object",
      "properties": {
        "window_location": {
          "type": "integer"
        },
        "window_height": {
          "type": "number"
        },
        "window_width": {
          "type": "number"
        },
        "draught_proofed": {
          "$ref": "#/$defs/boolean_string"
        },
        "glazing_type": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "window_type": {
          "type": "integer"
        },
        "orientation": {
          "type": "integer"
        },
        "window_transmission_details": {
          "type": "object",
          "properties": {
            "u_value": {
              "type": "number"
            },
            "solar_transmittance": {
              "type": "number"
            },
            "data_source": {
              "type": "integer"
            }
          }
        },
        "pvc_frame": {
          "$ref": "#/$defs/boolean_string"
        },
        "glazing_gap": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "frame_factor": {
          "type": "number"
        }
      },
      "required": [
        "window_location",
        "window_height",
        "window_width",
        "glazing_type",
        "window_type",
        "orientation"
      ]
    },
    "air_change_rate_item": {
      "type": "object",
      "properties": {
        "air_change_rate_month": {
          "type": "integer"
        },
        "air_change_rate_value": {
          "type": "number"
        }
      },
      "required": [
        "air_change_rate_month",
        "air_change_rate_value"
      ]
    },
    "sap_special_feature": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "energy_feature": {
          "type": "object",
          "properties": {
            "energy_saved_or_generated": {
              "$ref": "#/$defs/measurement_value"
            },
            "saved_or_generated_fuel": {
              "type": "integer"
            },
            "energy_used": {
              "$ref": "#/$defs/measurement_value"
            },
            "energy_used_fuel": {
              "type": "integer"
            },
            "air_change_rates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/air_change_rate_item"
              },
              "minItems": 12,
              "maxItems": 12
            }
          }
        },
        "emissions_feature": {
          "type": "object",
          "properties": {
            "emissions_saved": {
              "$ref": "#/$defs/measurement_value"
            },
            "emissions_created": {
              "$ref": "#/$defs/measurement_value"
            }
          }
        }
      },
      "required": [
        "description"
      ]
    }
  },
  "required": [
    "assessment_type",
    "schema_type",
    "created_at",
    "schema_version_original",
    "sap_version",
    "calculation_software_version",
    "inspection_date",
    "report_type",
    "completion_date",
    "registration_date",
    "status",
    "language_code",
    "property_type",
    "region_code",
    "country_code",
    "transaction_type",
    "tenure",
    "uprn_source",
    "current_energy_efficiency_band",
    "potential_energy_efficiency_band",
    "address_line_1",
    "post_town",
    "postcode",
    "walls",
    "roofs",
    "floors",
    "window",
    "main_heating",
    "main_heating_controls",
    "hot_water",
    "lighting",
    "secondary_heating",
    "has_hot_water_cylinder",
    "dwelling_type",
    "total_floor_area",
    "has_fixed_air_conditioning",
    "energy_rating_current",
    "energy_rating_potential",
    "energy_rating_average",
    "environmental_impact_current",
    "environmental_impact_potential",
    "energy_consumption_current",
    "energy_consumption_potential",
    "co2_emissions_current",
    "co2_emissions_current_per_floor_area",
    "co2_emissions_potential",
    "lighting_cost_current",
    "lighting_cost_potential",
    "heating_cost_current",
    "heating_cost_potential",
    "hot_water_cost_current",
    "hot_water_cost_potential",
    "built_form",
    "extensions_count",
    "door_count",
    "percent_draughtproofed",
    "habitable_room_count",
    "heated_room_count",
    "measurement_type",
    "mechanical_ventilation",
    "open_fireplaces_count",
    "solar_water_heating",
    "conservatory_type",
    "sap_building_parts",
    "sap_heating",
    "sap_energy_source"
  ],
  "properties": {
    "assessment_type": {
      "type": "string",
      "description": "Type of assessment. Always 'RdSAP' for this schema family.",
      "enum": [
        "RdSAP"
      ]
    },
    "schema_type": {
      "type": "string",
      "description": "The XSD schema version under which this certificate was lodged.",
      "enum": [
        "RdSAP-Schema-NI-17.4"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime when the record was created in the data warehouse."
    },
    "schema_version_original": {
      "type": "string",
      "description": "The schema version recorded inside the XML document itself at time of lodgement."
    },
    "sap_version": {
      "type": "number",
      "description": "Version of the SAP/RdSAP methodology used."
    },
    "calculation_software_version": {
      "type": "string",
      "description": "Version of the calculation software used to produce the assessment. The software name is redacted."
    },
    "inspection_date": {
      "type": "string",
      "format": "date",
      "description": "Date the property was inspected (YYYY-MM-DD)."
    },
    "report_type": {
      "type": "integer",
      "description": "Report type code. 2 = EPC."
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "description": "Date the report was completed (YYYY-MM-DD)."
    },
    "registration_date": {
      "type": "string",
      "format": "date",
      "description": "Date the report was registered on the national register (YYYY-MM-DD)."
    },
    "status": {
      "type": "string",
      "description": "Report status, e.g. 'entered', 'appealed', 'cancelled', 'not for issue'."
    },
    "language_code": {
      "type": "integer",
      "description": "Language code. 1 = English, 2 = Welsh."
    },
    "property_type": {
      "type": "integer",
      "description": "Property type code (0=house, 1=bungalow, 2=flat, 3=maisonette, 4=park home)."
    },
    "region_code": {
      "type": "integer",
      "description": "UK region code."
    },
    "country_code": {
      "type": "string",
      "description": "Country code: 'ENG', 'EAW', 'NI', 'SCT'."
    },
    "transaction_type": {
      "type": "integer",
      "description": "Transaction type code describing why the EPC was produced."
    },
    "tenure": {
      "type": "integer",
      "description": "Tenure type code (1=owner-occupied, 2=rented-social, 3=rented-private, etc.)."
    },
    "uprn": {
      "anyOf": [
        {
          "type": "integer",
          "description": "Unique Property Reference Number as a positive integer."
        },
        {
          "type": "null"
        }
      ],
      "description": "UPRN derived from the assessment_address_id (Energy Assessor-supplied) or from address matching. Null when neither source provides a valid UPRN."
    },
    "uprn_source": {
      "type": "string",
      "description": "Indicates how the UPRN was resolved: 'Energy Assessor', 'Address Matched', or '' (empty string when unresolved).",
      "enum": [
        "Energy Assessor",
        "Address Matched",
        ""
      ]
    },
    "current_energy_efficiency_band": {
      "type": "string",
      "description": "Energy efficiency band for current rating, derived from energy_rating_current.",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G"
      ]
    },
    "potential_energy_efficiency_band": {
      "type": "string",
      "description": "Energy efficiency band for potential rating, derived from energy_rating_potential.",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G"
      ]
    },
